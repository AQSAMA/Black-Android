<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns the drawing; this only gives the window a black background before the first frame. -->
    <style name="Theme.BlackControlCenter" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#070706</item>
        <item name="android:colorAccent">#D9A84E</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
